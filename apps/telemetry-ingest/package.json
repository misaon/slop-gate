{
  "name": "@misaon/slop-gate-telemetry-ingest",
  "version": "0.2.0",
  "private": true,
  "description": "Internal: receives anonymous telemetry from the slop-gate CLI.",
  "license": "MIT",
  "type": "module",
  "engines": {
