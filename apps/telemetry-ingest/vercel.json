{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @misaon/slop-gate-core build",
  "outputDirectory": "public",
  "functions": {
    "api/*.ts": {
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
