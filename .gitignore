.idea/
node_modules/
dist/
.slop-gate/
.turbo/
*.tsbuildinfo
.superpowers/
# engine-tsc's own tests need `typescript` (a peer dependency) to resolve for real, which requires
# Node's module resolution to walk up from the fixture directory into this repo's own hoisted
# node_modules — impossible from a fixture under the system temp dir, which shares no ancestor with
# this repo at all. Fixtures therefore live in a throwaway directory inside the package itself
# instead (see packages/engine-tsc/src/index.test.ts), always removed in `afterEach`.
.test-tmp/
# Stray artifact from a killed packages/cli/src/main.test.ts run (see 7159a6e) — narrowed from the
# original blanket `*.generated.ts`, which also matched packages/core/src/registry/entries.generated.ts
# and packages/core/src/concepts/concepts.generated.ts. Those two *are* committed: the registry
# generator (packages/core/scripts/generate-registry.ts) produces reviewable, diffable source per
# the design plan's decision 5, not a build artifact to hide.
main.broken-import.*.generated.ts

# Copied into each package by scripts/prepack.mjs at publish time; never committed.
packages/*/LICENSE
packages/*/README.md

# Source artwork. The sized, theme-split versions the README uses live in docs/assets/ and are
# tracked; these originals are 3 MB a clone has no use for. Ignored rather than merely untracked,
# because `git add -A` swept them into a rename PR once already.
/logo.png
/logo-wide-darkmode.png
/logo-wide-lightmode.png
/tf-logo.svg

# rules-explorer client build
packages/rules-explorer/dist/

# Reports the CI dogfood step writes for the annotations, the SARIF upload and the job summary.
/sgate.sarif
/sgate.json

# Credentials pulled from Vercel. Never committed — the repository is public and these are live.
.env
.env.*
!.env.example
.vercel
