{
  "name": "@misaon/slop-gate-reporters",
  "version": "0.0.0",
  "description": "Report formats for slop-gate: pretty, json, agent, sarif, github and gitlab.",
  "keywords": [
    "slop-gate",
    "code-quality",
    "static-analysis",
    "lint"
  ],
  "license": "MIT",
  "author": "Ond\u0159ej Mis\u00e1k",
  "homepage": "https://github.com/misaon/slop-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/slop-gate.git",
    "directory": "packages/reporters"
  },
  "bugs": {
    "url": "https://github.com/misaon/slop-gate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@misaon/slop-gate-core": "workspace:*"
  }
}
