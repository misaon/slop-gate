{
  "name": "@misaon/slop-gate-core",
  "version": "0.1.1",
  "description": "The slop-gate orchestrator: rule registry, arbitration, framework profiles, planner and cache.",
  "keywords": [
    "slop-gate",
    "code-quality",
    "static-analysis",
    "lint"
  ],
  "license": "MIT",
  "author": "Ondřej Misák",
  "homepage": "https://github.com/misaon/slop-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/slop-gate.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/misaon/slop-gate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:registry": "node scripts/generate-registry.ts",
    "generate:registry:check": "node scripts/generate-registry.ts --check",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "ignore": "catalog:",
    "oxc-transform": "catalog:",
    "picomatch": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@types/picomatch": "catalog:"
  }
}
