{
  "name": "@misaon/slop-gate-rules-explorer",
  "version": "0.1.1",
  "private": true,
  "description": "Internal: a visual index of every rule slop-gate knows about, its state and why.",
  "license": "MIT",
  "author": "Ondřej Misák",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite",
    "serve": "node --experimental-strip-types --env-file-if-exists=../../.env.local server/serve.ts",
    "payload": "node --experimental-strip-types server/build-payload.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@misaon/slop-gate-core": "workspace:*",
    "@neondatabase/serverless": "catalog:",
    "@tanstack/table-core": "catalog:",
    "hono": "catalog:",
    "lucide-preact": "catalog:",
    "motion": "catalog:",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@preact/preset-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
