{
  "name": "@misaon/slop-gate-engine-schema",
  "version": "0.1.0",
  "description": "JSON Schema adapter for slop-gate: validates config files against their published schemas.",
  "keywords": [
    "slop-gate",
    "code-quality",
    "static-analysis",
    "lint"
  ],
  "license": "MIT",
  "author": "Ondřej Misák",
  "homepage": "https://github.com/misaon/slop-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/slop-gate.git",
    "directory": "packages/engine-schema"
  },
  "bugs": {
    "url": "https://github.com/misaon/slop-gate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-compose-spec.txt"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@misaon/slop-gate-core": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  }
}
