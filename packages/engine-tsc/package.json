{
  "name": "@misaon/slop-gate-engine-tsc",
  "version": "0.2.0",
  "description": "TypeScript compiler adapter for slop-gate.",
  "keywords": [
    "slop-gate",
    "code-quality",
    "static-analysis",
    "lint"
  ],
  "license": "MIT",
  "author": "Ondřej Misák",
  "homepage": "https://github.com/misaon/slop-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/slop-gate.git",
    "directory": "packages/engine-tsc"
  },
  "bugs": {
    "url": "https://github.com/misaon/slop-gate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@misaon/slop-gate-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
