{
  "name": "@misaon/slop-gate",
  "version": "0.0.0",
  "description": "One code-quality gate for AI-assisted repositories: many analysers, one config, one diagnostic model.",
  "keywords": [
    "lint",
    "linter",
    "code-quality",
    "static-analysis",
    "ai",
    "oxlint",
    "knip",
    "typescript",
    "monorepo",
    "cli"
  ],
  "license": "MIT",
  "author": "Ond\u0159ej Mis\u00e1k",
  "homepage": "https://github.com/misaon/slop-gate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misaon/slop-gate.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/misaon/slop-gate/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "sgate": "./bin/sgate.js",
    "slop-gate": "./bin/sgate.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@misaon/slop-gate-core": "workspace:*",
    "@misaon/slop-gate-engine-actionlint": "workspace:*",
    "@misaon/slop-gate-engine-astgrep": "workspace:*",
    "@misaon/slop-gate-engine-biome-css": "workspace:*",
    "@misaon/slop-gate-engine-deps-security": "workspace:*",
    "@misaon/slop-gate-engine-hadolint": "workspace:*",
    "@misaon/slop-gate-engine-knip": "workspace:*",
    "@misaon/slop-gate-engine-oxfmt": "workspace:*",
    "@misaon/slop-gate-engine-oxlint": "workspace:*",
    "@misaon/slop-gate-engine-schema": "workspace:*",
    "@misaon/slop-gate-engine-tsc": "workspace:*",
    "@misaon/slop-gate-reporters": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "citty": "^0.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  }
}
