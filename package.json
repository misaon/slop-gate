{
  "name": "slop-gate-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "generate:registry": "turbo run build --filter=@misaon/slop-gate-engine-oxlint && pnpm --filter @misaon/slop-gate-core generate:registry",
    "generate:registry:check": "turbo run build --filter=@misaon/slop-gate-engine-oxlint && pnpm --filter @misaon/slop-gate-core generate:registry:check",
    "dogfood": "pnpm build --output-logs=errors-only && sgate check --max-warnings 0",
    "check": "pnpm typecheck && pnpm test && pnpm dogfood",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm build --output-logs=errors-only && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@misaon/slop-gate": "workspace:*",
    "@misaon/slop-gate-engine-oxlint": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
